{
  "expo": {
    "name": "GattaiMate",
    "slug": "gattaimate",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "gattaimate",
    "android": {
      "package": "com.gattaimate.pdfmerger",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0B1E"
      }
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": [
            "*/*"
          ],
          "androidMultiIntentFilters": [
            "*/*"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "GattaiMate uses the camera to scan documents into PDFs.",
          "photosPermission": "GattaiMate lets you pick photos to turn into PDFs."
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0B1E"
    }
  }
}
